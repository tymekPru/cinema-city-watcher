# Przykładowa konfiguracja lokalna (skopiuj do .env albo ustaw w środowisku).
# Wszystkie wartości mają sensowne domyślne — patrz README.

# CINEMA_ID=1052            # Praha Flora (IMAX)
# FILM_ID=7268s2r           # Odyssea — pewniejsze niż dopasowanie po nazwie
# FILM_MATCH=odys
# REQUIRED_ATTRS=70-mm      # puste = wszystkie seanse filmu
# HORIZON_DAYS=45
# CAPACITY=385              # pojemność sali IMAX VOLVO; 0 = alerty w procentach

# NOTIFY_BACKEND=console    # lokalnie: console; w Lambdzie: ses
# SES_FROM=twoj@adres.pl
# SES_TO=twoj@adres.pl

# STATE_BACKEND=file        # lokalnie: file; w Lambdzie: dynamodb
# DDB_TABLE=cc-watcher-state
# WATCHER_AWS_REGION=eu-central-1
